---
# Configuração do ansible-lint para este playbook local.
#
# Contexto: até então não havia arquivo de config, então o ansible-lint
# rodava o profile "production" completo e acusava 614 violações — 79%
# apenas convenções de estilo que o projeto nunca adotou. Sem config, o
# hook de pre-commit bloqueava qualquer commit.

# Sem profile fixo: aplicamos as regras padrão e ajustamos abaixo.
profile: null

# Regras desativadas — puro estilo/falso-positivo, sem valor aqui:
skip_list:
  # Nomes curtos de módulo (copy:, file:, template:) são válidos e legíveis.
  - fqcn
  # Convenção de prefixar variáveis de role com <role>_ nunca foi adotada.
  - var-naming
  # A play define `become: yes` globalmente; as tasks só trocam become_user.
  - partial-become

# Regras mantidas, porém como aviso (não bloqueiam o commit). São achados
# legítimos que valem correção gradual — alinhados ao CLAUDE.md
# (idempotência: changed_when/creates, evitar shell com pipe, etc.).
warn_list:
  - no-changed-when
  - command-instead-of-module
  - command-instead-of-shell
  - risky-shell-pipe
  - risky-file-permissions
  - name[missing]
  - latest[git]
  - yaml[line-length]
  - yaml[document-start]
  - yaml[braces]
  - yaml[empty-lines]
  - yaml[comments]
